<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="@color/surface_high"
            android:contentDescription="@null"
            app:shapeAppearanceOverlay="@style/NexIconShape" />

        <ImageView
            android:id="@+id/imgLock"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_lock_badge"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:tint="@color/primary" />

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_add_circle"
            android:contentDescription="@string/cd_in_profile"
            android:padding="4dp"
            android:src="@drawable/ic_work"
            android:visibility="gone"
            app:tint="@color/on_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/on_surface"
        android:textSize="12sp" />
</LinearLayout>
