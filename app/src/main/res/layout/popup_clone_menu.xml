<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/menuBug"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_bug"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/menu_bug"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuShortcut"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_apps"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/menu_shortcut"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuEdit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/menu_edit"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuRepair"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_build"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/menu_repair"
            android:textColor="@color/on_surface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuDelete"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_tile_danger"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/menu_delete"
            android:textColor="@color/danger"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
