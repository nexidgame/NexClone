<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dipakai profil klon untuk menghentikan proses aplikasi klon (Manajemen tugas) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Daftar aplikasi yang bisa dikloning (tanpa QUERY_ALL_PACKAGES) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NexCloneApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexClone">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".PickAppActivity" android:exported="false" />
        <activity android:name=".EditCloneActivity" android:exported="false" />
        <activity android:name=".UserCenterActivity" android:exported="false" />
        <activity android:name=".ManageActivity" android:exported="false" />
        <activity android:name=".PrivateSpaceActivity" android:exported="false" />
        <activity android:name=".InfoActivity" android:exported="false" />

        <!-- Peluncur klon (dipakai pintasan desktop & kunci aplikasi) -->
        <activity
            android:name=".LaunchCloneActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.NexClone.Translucent" />

        <!-- ===== Pengelola profil kerja (Device Policy Controller) ===== -->
        <receiver
            android:name=".admin.NexAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".admin.ProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@style/Theme.NexClone.Translucent">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@style/Theme.NexClone.Translucent">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Nonaktif di profil utama; diaktifkan hanya di dalam profil klon (lihat ProfileSetup) -->
        <activity
            android:name=".admin.ProfileOpActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.NexClone.Translucent">
            <intent-filter>
                <action android:name="com.nex.clone.action.PROFILE_OP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Menyimpan pilihan bahasa pada Android 11-12 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
